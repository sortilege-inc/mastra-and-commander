# frozen_string_literal: true

source 'https://rubygems.org'

# Squib — print-and-play card prototyping DSL (renders via cairo/pango/rsvg).
# https://squib.rocks  |  https://github.com/andymeneely/squib
gem 'squib', '~> 0.19'

# Squib pulls these from the stdlib; they leave Ruby's default gems in 3.4, so
# pin them explicitly to keep the build quiet and future-proof.
gem 'abbrev'
gem 'bigdecimal'
gem 'csv'
